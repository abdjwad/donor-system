# ─────────────────────────────────────────────────────────────────
# Blockchain Environment Variables — Bunian Platform
# انسخ هذا الملف إلى .env واملأ القيم
# لا ترفع ملف .env أبداً على GitHub
# ─────────────────────────────────────────────────────────────────

# المفتاح الخاص لمحفظة النشر (من MetaMask → Account Details → Export Private Key)
# مثال: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_PRIVATE_KEY=your_private_key_here

# مفتاح Alchemy API (من alchemy.com → Create App → Polygon Amoy)
# مثال: abc123xyz...
ALCHEMY_API_KEY=your_alchemy_api_key_here

# مفتاح Polygonscan API (من polygonscan.com → API Keys)
# يُستخدم للتحقق من العقود وعرض الكود المصدري
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
